SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=
# Reading mail. IMAP_USER and IMAP_PASS fall back to the SMTP pair above when
# left blank, which is the intended setup — same account, same app password.
# Gmail needs IMAP enabled in its settings. DRY_RUN does not gate these.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX
IMAP_USER=
IMAP_PASS=
DRY_RUN=true
SEND_DELAY_SECONDS=2
DB_PATH=db/rfq.db
